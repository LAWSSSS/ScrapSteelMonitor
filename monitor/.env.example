MYSQL_HOST=172.16.16.101
MYSQL_PORT=33306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=slzj
# 镔鑫场景（PostgreSQL）。只有跑 binxin 分支的扫描/修正时才需要。
BINXIN_PG_HOST=172.31.1.102
BINXIN_PG_PORT=5432
BINXIN_PG_USER=postgres
BINXIN_PG_PASSWORD=
BINXIN_PG_DB=ssqi_fcs
BINXIN_API_BASE=http://172.31.1.102:8081/fcs
# 镔鑫写库封锁闸。留空时扫描、出方案、看板都能用，但批准落库一律被拒。
# 要真正改库必须同时满足两件事：这一行设成 yes-i-approve，且在看板上点过「解锁写库」
# （解锁默认只管 30 分钟，过期自动锁回）。不要长期留着这个值。
BINXIN_ALLOW_WRITE=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# VPN 保活：把鼠标放到安全空白处后运行
# python3 -m monitor.vpn_keepalive --save-origin
# 或 Windows 双击 monitor\windows\保存鼠标起点.bat
MOUSE_ORIGIN_X=
MOUSE_ORIGIN_Y=
MOUSE_CLICK_PROB=0.4
