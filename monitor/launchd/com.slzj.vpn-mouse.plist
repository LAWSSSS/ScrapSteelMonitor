  <true/>
  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/monitor/logs/vpn_mouse.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/monitor/logs/vpn_mouse.err.log</string>
